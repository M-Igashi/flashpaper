{
  "name": "flashpaper",
  "main": "src/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // R2 bucket for static files (Google verification, sitemap)
  "r2_buckets": [
    {
      "binding": "SITE_BUCKET",
      "bucket_name": "misc"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "NOTE_STORE", "class_name": "NoteStore" },
      { "name": "STATS_STORE", "class_name": "StatsStore" },
      { "name": "CHAT_STORE", "class_name": "ChatStore" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NoteStore"] },
    { "tag": "v2", "new_sqlite_classes": ["StatsStore"] },
    { "tag": "v3", "new_sqlite_classes": ["ChatStore"] }
  ],

  // Observability disabled: avoids Cloudflare capturing/retaining request
  // metadata and headers (incl. client IP) in Workers Logs for up to 7 days.
  "observability": {
    "enabled": false
  }

  // Environment variables: Set CF_ANALYTICS_TOKEN via Cloudflare dashboard or .dev.vars for local dev
}
